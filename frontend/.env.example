# API Base URL for FIF Branch Signal API
# Production default: https://api-fif.kepiai.co
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Image analysis tab (app/vision/route.ts). Server-side only; never prefix with NEXT_PUBLIC_.
# GEMINI_MODEL is optional and defaults to gemini-3.8-flash. GEMINI_FALLBACK_MODEL is asked when
# that one is overloaded, out of quota or too slow, and defaults to gemini-2.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Mistral is the other provider the page can send a picture to. MISTRAL_MODEL defaults to
# mistral-medium-latest, MISTRAL_FALLBACK_MODEL to mistral-large-latest. VISION_PROVIDER picks
# the default when a request names none: gemini (default) or mistral.
MISTRAL_API_KEY=
MISTRAL_MODEL=
MISTRAL_FALLBACK_MODEL=
VISION_PROVIDER=
